# Copy this file to .env and replace the required values with random values before starting Docker Compose.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional invitation email delivery. Leave SMTP_HOST blank for manual token delivery in local development.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS_MODE=starttls

# Deployment settings. Set these to the exact public HTTPS URLs before launch.
WEB_ORIGINS=http://localhost:3000,http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true only behind a trusted proxy that replaces X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=false
